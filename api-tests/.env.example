# Copy to .env (all environments) or .env.<TEST_ENV> (one environment). Never commit real values.
# Real environment variables (e.g. CI secrets) always take precedence over these files.

TEST_ENV=dev

# --- Services ---
PETSTORE_BASE_URL=https://petstore3.swagger.io/api/v3
PETSTORE_API_KEY=special-key
# PETSTORE_TOKEN_URL=
# PETSTORE_CLIENT_ID=
# PETSTORE_CLIENT_SECRET=

# --- Auto-discovered services (any file dropped into specs/) ---
# Prefix = file name in UPPER_SNAKE: "orders-api.yaml" -> ORDERS_API
# ORDERS_API_BASE_URL=https://orders.qa.example.com   # needed when the spec has no absolute server URL
# ORDERS_API_AUTH_TYPE=bearer                        # optional; otherwise inferred from the spec
# ORDERS_API_TOKEN=                                  # bearer
# ORDERS_API_API_KEY=                                # apiKey (ORDERS_API_API_KEY_NAME / _API_KEY_IN to override)
# ORDERS_API_USERNAME= / ORDERS_API_PASSWORD=        # basic or cookie (+ ORDERS_API_LOGIN_PATH)
# ORDERS_API_CLIENT_ID= / ORDERS_API_CLIENT_SECRET= / ORDERS_API_TOKEN_URL= / ORDERS_API_SCOPE=   # oauth2
# SPEC_DISCOVERY=false                               # turn discovery off

# --- Generated suites ---
# SUITES=contract,positive,negative,boundary,security,resilience,performance
# SUITE_SERVICES=petstore    # limit to services
# SUITE_TAGS=pet             # limit to spec tags
# SUITE_OPS=addPet,get*      # limit to operations (wildcards)
# SUITE_MAX_CASES=25         # cap per operation and category
# SLA_MS=3000                # p95 latency budget

# --- Run ---
# WORKERS=4
# TEST_RETRIES=1
# HTTP_RETRIES=2
# HTTP_TIMEOUT_MS=30000
# LOG_LEVEL=info            # debug | info | warn | error | silent
# DATA_SEED=12345           # replay the exact data from a previous run (seed is in the report)
# AUTO_VALIDATE=true        # schema-check every documented response

# --- Chat summary ---
# CHAT_PROVIDER=slack       # slack | teams
# CHAT_WEBHOOK_URL=
# CHAT_ONLY_ON_FAILURE=false
# CHAT_DRY_RUN=true
# REPORT_URL=               # link to the hosted HTML report
